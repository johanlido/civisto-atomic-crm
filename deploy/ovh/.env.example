# Public DNS names (A/AAAA records must point to the OVHCloud server)
CRM_DOMAIN=crm.example.se
API_DOMAIN=api.crm.example.se
MCP_DOMAIN=mcp.crm.example.se
ACME_EMAIL=ops@example.se

# Supabase public client key. This key is embedded in the frontend by design.
SUPABASE_ANON_KEY=replace-with-self-hosted-anon-key

# Supabase service-role key. Server-side secret; never expose in frontend code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-self-hosted-service-role-key

# Prefer the local host-only gateway exposed by the self-hosted Supabase stack.
SUPABASE_INTERNAL_URL=http://host.docker.internal:8000
SUPABASE_GATEWAY_UPSTREAM=host.docker.internal:8000

# Generate with: openssl rand -hex 32
MCP_API_KEY=replace-with-at-least-32-random-characters

# Optional inbound Postmark address shown in CRM.
VITE_INBOUND_EMAIL=
