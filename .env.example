# Copy this file to `.env.development` for local work:
#   cp .env.example .env.development
# `make start` will copy it automatically if `.env.development` is missing.
#
# Never commit real `.env*` files. Production values belong in the host
# environment or in gitignored files such as `.env.production.local`.

SKIP_PREFLIGHT_CHECK=true

# Local Supabase CLI (http://127.0.0.1:54321). The JWT values below are the
# well-known local-dev defaults published by Supabase, NOT hosted project keys.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_IS_DEMO=false

# Optional. Shown in Settings so users can CC the CRM. Use your own Postmark
# inbound address in local/production env files — do not commit a real one.
VITE_INBOUND_EMAIL=you@inbound.postmarkapp.com

# Injected by `supabase functions serve` for admin edge functions. Same
# well-known local-dev default as above — replace only in a gitignored file.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Local Supabase Postgres (password is the CLI default).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
